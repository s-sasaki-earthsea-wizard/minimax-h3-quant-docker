# Template for .env, which is gitignored because HOST_UID/HOST_GID are specific
# to your machine and COMFY_EXTRA_ARGS is a scratchpad you will edit while
# tuning. `make` copies this file to .env on first run and substitutes your own
# uid/gid; edit .env, not this file.

# Pinned versions ------------------------------------------------------------
# v0.30.2 ships nodes_minimax_h3.py and nodes_easycache.py natively.
COMFYUI_REF=v0.30.2
# cu130 wheel; matches the reference stack validated on 16 GB Blackwell.
TORCH_VERSION=2.12.0
# SageAttention is built from source at this commit: the PyPI 1.0.6 release
# lacks the int8/fp8 kernels the KJNodes MiniMax H3 patch node imports.
SAGEATTENTION_REF=d1a57a546c3d395b1ffcbeecc66d81db76f3b4b5

# Host identity for bind-mount ownership -------------------------------------
# The container runs as a non-root user created with these ids so that files
# written into ./data stay owned by you. `make` fills these in from `id -u`
# and `id -g`; the values below are only the fallback.
HOST_UID=1000
HOST_GID=1000

# Runtime --------------------------------------------------------------------
COMFY_PORT=8188

# Appended verbatim to the ComfyUI command line. Useful escalations if a run
# OOMs, roughly in order of how much they cost you:
#   --reserve-vram 1.5   keep headroom for the desktop compositor
#   --cache-none         re-execute every node, minimum RAM/VRAM retention
#   --novram             last resort
COMFY_EXTRA_ARGS=
